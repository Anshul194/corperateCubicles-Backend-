# ============================================================
# Edrilla LMS Backend — environment template
# Copy to .env and fill in values. NEVER commit real secrets.
# Variables marked [required] must be set for the server to work.
# ============================================================

# --- Core ---
# NODE_ENV gates the Secure cookie default and error-stack suppression.
# MUST be 'production' in production (or set COOKIE_SECURE=true as a belt-and-braces).
NODE_ENV=development
PORT=5050                                  # note: macOS ControlCenter occupies 5000
MONGO_URI=mongodb://127.0.0.1:27017/edrilla_dev   # [required]
# MONGODB_URI=                             # legacy alias read in a few scripts

# --- Auth / JWT [required] ---
JWT_ACCESS_TOKEN_SECRET_KEY=change-me
JWT_ACCESS_SECRET=change-me                # alias still read in some modules — keep equal to the above
JWT_REFRESH_TOKEN_SECRET_KEY=change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Cookies / CORS ---
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
# COOKIE_SECURE: explicit override for the Secure attribute on auth cookies,
# independent of NODE_ENV (utils/tokens/setTokensCookies.js).
#   true  -> always send Secure (SET THIS IN PRODUCTION — fail-safe even if
#            NODE_ENV is forgotten; requires HTTPS or browsers drop the cookies)
#   false -> never send Secure (plain-HTTP local/staging only)
#   unset -> Secure when NODE_ENV=production (legacy behavior)
# COOKIE_SECURE=true
FRONTEND_URL=http://localhost:5173
FRONTEND_HOST=localhost

# --- Rate limiting / body size (optional, sane defaults in code) ---
# RATE_LIMIT_MAX=
# AUTH_RATE_LIMIT_MAX=
# AI_CHAT_RATE_LIMIT_MAX=
# JSON_BODY_LIMIT=

# --- Mail (SMTP_* and MAIL_* are both read in different mailers) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Edrilla

# --- Redis (optional for single-instance/local dev; REQUIRED for any
# multi-instance deploy: backs shared rate-limit counters (app.js), the token
# blacklist/revocation (utils/tokens/generateTokens.js), cache and queues —
# when unset, each instance falls back to per-process in-memory state) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
VIDEO_PROGRESS_QUEUE_ENABLED=false

# --- AI / vector search (optional — server boots without these) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lms_knowledge

# --- Video hosting (VdoCipher; both spellings are read in code) ---
VDOCIPHER_API_KEY=
VDOCIPHER_API=
VDOCIPHER_API_URL=
VDOCIPHER_SECRET=
VIDEOCYPHER_API_KEY=
VIDEOCYPHER_FOLDER_ID=

# --- Zoom ---
ZOOM_ACCOUNT_ID=
ZOOM_ACCOUNT_EMAIL=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# --- Firebase (push notifications) ---
# Either inline JSON or a path to the service-account file:
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# --- Misc ---
WORDPRESS_NEWS_URL=
MANUAL_UPLOAD_PATH=
UPLOAD_EXCEL_STAGING_DIR=

# --- LapaasOS CRM ticket ingestion ---
# LAPAAS_TICKET_URL=https://npdmlsgiupranumqkgum.supabase.co/functions/v1/ticket-ingest/ticket

# --- Mobile app version gates ---
APP_VERSION=
ANDROID_APP_VERSION=
IOS_APP_VERSION=
FORCE_UPDATE=false
ANDROID_FORCE_UPDATE=false
